#!/bin/bash
# boobox-setup-github: One-time reproducible Git + GitHub setup for all boo_box sandboxes.
#
# Zero plaintext tokens in config.json! Stores GH_TOKEN inside boo_box's host-only vault
# (`~/boo_box/vault/connections.json`, mode 0700/0600, kernel-denied by Seatbelt), configures
# host ~/.gitconfig (`user.name`, `user.email`, `gh auth setup-git`), enables
# `allowHostGitConfig` + `shareGHConfig`, and triggers live reload on any running boo_box.app
# so already-open tabs pick up GH_TOKEN immediately on the very next command.
#
# Usage:
#   boo setup-github                 Interactive setup (reuses host `gh` OAuth or prompts for PAT)
#   boo setup-github --from-gh       Non-interactive: import active host `gh` OAuth token into vault
#   boo setup-github --token <pat>   Non-interactive: store explicit fine-grained PAT in vault
#   boo setup-github --name "..." --email "..."   Set git identity explicitly
#   boo setup-github --status        Show current GitHub sandbox setup status (never prints token)
#   boo setup-github --remove        Delete GitHub token from host vault & disable connection

set -euo pipefail

CONFIG_DIR="$HOME/boo_box"
CONFIG_FILE="$CONFIG_DIR/config.json"
VAULT_DIR="$CONFIG_DIR/vault"
VAULT_FILE="$VAULT_DIR/connections.json"
APP_SOCK="$CONFIG_DIR/run/app.sock"

MODE="interactive"
TOKEN_ARG=""
GIT_NAME_ARG=""
GIT_EMAIL_ARG=""

usage() {
  cat <<'EOF'
boo setup-github — One-time Git + GitHub setup for all boo_box sandboxes

Zero plaintext secrets in config.json! Stores GH_TOKEN in ~/boo_box/vault/connections.json
(0700/0600, Seatbelt kernel-denied) and hot-reloads active sandbox tabs immediately.

Usage:
  boo setup-github                 Interactive setup (host `gh` OAuth or fine-grained PAT)
  boo setup-github --from-gh       Import existing host `gh auth token` into host vault
  boo setup-github --token <pat>   Store explicit fine-grained PAT in host vault
  boo setup-github --name "Name"   Set host git user.name (optional)
  boo setup-github --email "a@b"   Set host git user.email (optional)
  boo setup-github --status        Show current GitHub setup status (never prints token)
  boo setup-github --remove        Remove GitHub token from host vault & disable connection
EOF
}

while [ "$#" -gt 0 ]; do
  case "$1" in
    -h|--help) usage; exit 0 ;;
    --from-gh) MODE="from-gh"; shift ;;
    --status) MODE="status"; shift ;;
    --remove) MODE="remove"; shift ;;
    --token)
      [ "$#" -ge 2 ] || { echo "boo setup-github: --token requires a value" >&2; exit 2; }
      MODE="token"
      TOKEN_ARG="$2"
      shift 2
      ;;
    --name)
      [ "$#" -ge 2 ] || { echo "boo setup-github: --name requires a value" >&2; exit 2; }
      GIT_NAME_ARG="$2"
      shift 2
      ;;
    --email)
      [ "$#" -ge 2 ] || { echo "boo setup-github: --email requires a value" >&2; exit 2; }
      GIT_EMAIL_ARG="$2"
      shift 2
      ;;
    *)
      echo "boo setup-github: unknown argument: $1" >&2
      usage >&2
      exit 2
      ;;
  esac
done

notify_running_app() {
  if [ -S "$APP_SOCK" ]; then
    python3 - "$APP_SOCK" <<'PY' 2>/dev/null || true
import json, socket, sys
s = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
s.settimeout(1.5)
s.connect(sys.argv[1])
s.sendall((json.dumps({"op": "reload_config"}) + "\n").encode())
s.close()
PY
  fi
}

if [ "$MODE" = "status" ]; then
  NAME="$(git config --global --get user.name 2>/dev/null || true)"
  EMAIL="$(git config --global --get user.email 2>/dev/null || true)"
  HELPER="$(git config --global --get-all credential.https://github.com.helper 2>/dev/null | tr '\n' ' ' || true)"
  echo "Git user.name          : ${NAME:-<unset>}"
  echo "Git user.email         : ${EMAIL:-<unset>}"
  echo "GitHub HTTPS helper    : ${HELPER:-<unset>}"
  python3 - "$CONFIG_FILE" "$VAULT_FILE" <<'PY'
import json, os, sys
cfg_path, vault_path = sys.argv[1], sys.argv[2]
vault = {}
if os.path.exists(vault_path):
    try:
        vault = json.load(open(vault_path))
    except Exception:
        pass
has_tok = bool((vault.get("github") or "").strip())
print("Host vault GH token    :", "yes (~/boo_box/vault/connections.json)" if has_tok else "no")
if not os.path.exists(cfg_path):
    print("boo_box config.json    : <missing>")
    sys.exit(0)
cfg = json.load(open(cfg_path))
sa = cfg.get("sandboxAccess", {})
accts = cfg.get("connections", {}).get("accounts", [])
gh = next((a for a in accts if a.get("id") == "github"), None)
print("allowHostGitConfig     :", sa.get("allowHostGitConfig", False))
print("shareGHConfig          :", sa.get("shareGHConfig", False))
print("Connection enabled     :", f"{gh.get('enabled', False)} (label={gh.get('accountLabel') or 'None'})" if gh else "not configured")
PY
  exit 0
fi

if [ "$MODE" = "remove" ]; then
  python3 - "$CONFIG_FILE" "$VAULT_FILE" <<'PY'
import json, os, sys
cfg_path, vault_path = sys.argv[1], sys.argv[2]
if os.path.exists(vault_path):
    try:
        v = json.load(open(vault_path))
        if "github" in v:
            del v["github"]
            with open(vault_path, "w") as f:
                json.dump(v, f, indent=2, sort_keys=True)
            os.chmod(vault_path, 0o600)
    except Exception:
        pass
if os.path.exists(cfg_path):
    cfg = json.load(open(cfg_path))
    conns = cfg.setdefault("connections", {})
    conns["accounts"] = [a for a in conns.get("accounts", []) if a.get("id") != "github"]
    with open(cfg_path, "w") as f:
        json.dump(cfg, f, indent=2, sort_keys=True)
    os.chmod(cfg_path, 0o600)
PY
  notify_running_app
  echo "Removed GitHub token from ~/boo_box/vault/connections.json and disabled GitHub connection."
  exit 0
fi

# Resolve token cleanly (never echoed!)
TOKEN=""
LABEL=""

if [ "$MODE" = "token" ]; then
  TOKEN="$TOKEN_ARG"
elif [ "$MODE" = "from-gh" ]; then
  command -v gh >/dev/null 2>&1 || { echo "boo setup-github: gh CLI not found (brew install gh)" >&2; exit 1; }
  TOKEN="$(gh auth token 2>/dev/null || true)"
  if [ -z "$TOKEN" ]; then
    echo "boo setup-github: host gh CLI is not logged in. Run 'gh auth login' first." >&2
    exit 1
  fi
else
  echo "boo_box — One-time Git + GitHub Setup"
  echo "-------------------------------------"
  if command -v gh >/dev/null 2>&1 && gh auth token >/dev/null 2>&1; then
    echo "Detected existing host 'gh' OAuth login."
    printf "  [1] Reuse host 'gh' OAuth token (1-step, fastest)\n"
    printf "  [2] Paste a repo-scoped Fine-Grained PAT (recommended least-privilege)\n"
    printf "Choose [1/2] (default 1): "
    read -r CHOICE
    CHOICE="${CHOICE:-1}"
  else
    CHOICE="2"
  fi
  if [ "$CHOICE" = "1" ]; then
    TOKEN="$(gh auth token)"
  else
    echo "Create a Fine-Grained PAT (Repository permissions: Contents RW + Pull requests RW):"
    echo "  https://github.com/settings/personal-access-tokens/new"
    printf "Paste GitHub token (input hidden): "
    stty -echo 2>/dev/null || true
    read -r TOKEN
    stty echo 2>/dev/null || true
    echo ""
  fi
fi

TOKEN="$(printf '%s' "$TOKEN" | tr -d '\r\n')"
if [ -z "$TOKEN" ]; then
  echo "boo setup-github: empty token; aborted." >&2
  exit 1
fi

# Resolve GitHub login / name / email via GitHub API (best-effort)
if command -v curl >/dev/null 2>&1; then
  USER_JSON="$(curl -fsSL --max-time 6 -H "Authorization: Bearer $TOKEN" -H "Accept: application/vnd.github+json" https://api.github.com/user 2>/dev/null || true)"
  if [ -n "$USER_JSON" ]; then
    LABEL="$(printf '%s' "$USER_JSON" | python3 -c 'import json,sys; d=json.load(sys.stdin); print(d.get("login") or "")' 2>/dev/null || true)"
    API_NAME="$(printf '%s' "$USER_JSON" | python3 -c 'import json,sys; d=json.load(sys.stdin); print(d.get("name") or d.get("login") or "")' 2>/dev/null || true)"
    API_EMAIL="$(printf '%s' "$USER_JSON" | python3 -c 'import json,sys; d=json.load(sys.stdin); id_=d.get("id"); login=d.get("login"); print(d.get("email") or (f"{id_}+{login}@users.noreply.github.com" if id_ and login else ""))' 2>/dev/null || true)"
  fi
fi

# Configure host ~/.gitconfig identity & gh credential helper (idempotent)
CUR_NAME="$(git config --global --get user.name 2>/dev/null || true)"
CUR_EMAIL="$(git config --global --get user.email 2>/dev/null || true)"
FINAL_NAME="${GIT_NAME_ARG:-${CUR_NAME:-${API_NAME:-}}}"
FINAL_EMAIL="${GIT_EMAIL_ARG:-${CUR_EMAIL:-${API_EMAIL:-}}}"

if [ -n "$FINAL_NAME" ] && [ "$FINAL_NAME" != "$CUR_NAME" ]; then
  git config --global user.name "$FINAL_NAME"
fi
if [ -n "$FINAL_EMAIL" ] && [ "$FINAL_EMAIL" != "$CUR_EMAIL" ]; then
  git config --global user.email "$FINAL_EMAIL"
fi
if command -v gh >/dev/null 2>&1; then
  GH_TOKEN="$TOKEN" gh auth setup-git >/dev/null 2>&1 || true
fi

# Store token inside Seatbelt-denied host vault (0700/0600) — NEVER in config.json!
mkdir -p "$VAULT_DIR"
chmod 700 "$VAULT_DIR"
BOOBOX_GH_TOKEN="$TOKEN" python3 - "$VAULT_FILE" "$CONFIG_FILE" "$LABEL" <<'PY'
import json, os, sys

vault_path, cfg_path, label = sys.argv[1], sys.argv[2], sys.argv[3]
token = os.environ["BOOBOX_GH_TOKEN"]

vault = {}
if os.path.exists(vault_path):
    try:
        vault = json.load(open(vault_path))
    except Exception:
        vault = {}
vault["github"] = token
tmp_v = vault_path + ".tmp"
with open(tmp_v, "w") as f:
    json.dump(vault, f, indent=2, sort_keys=True)
os.chmod(tmp_v, 0o600)
os.replace(tmp_v, vault_path)

cfg = {}
if os.path.exists(cfg_path):
    try:
        cfg = json.load(open(cfg_path))
    except Exception:
        cfg = {}
sa = cfg.setdefault("sandboxAccess", {})
sa["allowHostGitConfig"] = True
sa["shareGHConfig"] = True
conns = cfg.setdefault("connections", {})
accounts = [a for a in conns.get("accounts", []) if a.get("id") != "github"]
entry = {"id": "github", "enabled": True, "envVar": "GH_TOKEN"}
if label:
    entry["accountLabel"] = label
accounts.insert(0, entry)
conns["accounts"] = accounts
# Clean up any legacy plaintext GH_TOKEN/GITHUB_TOKEN from ephemeralSetup.envVars
eph = cfg.get("ephemeralSetup")
if isinstance(eph, dict) and isinstance(eph.get("envVars"), list):
    eph["envVars"] = [e for e in eph["envVars"] if e.get("key") not in ("GH_TOKEN", "GITHUB_TOKEN")]
tmp_c = cfg_path + ".tmp"
with open(tmp_c, "w") as f:
    json.dump(cfg, f, indent=2, sort_keys=True)
os.chmod(tmp_c, 0o600)
os.replace(tmp_c, cfg_path)
PY

notify_running_app

echo "Done! GitHub is connected for all boo_box sandboxes:"
echo "  Vault   : ~/boo_box/vault/connections.json (0600, Seatbelt kernel-denied; zero secrets in config.json)"
echo "  Account : ${LABEL:-authenticated}"
echo "  Git ID  : ${FINAL_NAME:-<unset>} <${FINAL_EMAIL:-<unset>}>"
echo "  Live    : Open tabs hot-reload GH_TOKEN before their next command; new tabs inherit it automatically."
