#!/bin/bash
set -euo pipefail

usage() {
    cat <<'EOF'
boo — boo_box CLI for isolated APFS sandboxes and the shared global sandbox env

Sandbox Sessions:
  boo                         Open current directory in a sandbox (or activate if in ~ / /)
  boo .                       Open current directory (~20 ms CoW overlay by default)
  boo <dir>                   Open <dir> in an isolated sandbox session
  boo --no-env [dir]          Hide host .env / .env.* secret files (keeps .env.example)
  boo --overlay [dir]         Force instant O(1) ~20 ms CoW overlay mount (default)
  boo --clone / --full [dir]  Force frozen APFS full clone (including node_modules)
  boo --slim [dir]            Force frozen APFS slim clone (skip node_modules & caches)
  boo --scratch               Open a fresh empty scratch sandbox session

Global Sandbox Environment (~/boo_box/env — shared across all sessions):
  boo env run '<script>'      Run any install script inside Seatbelt with HOME=~/boo_box/env
  boo env shell               Open a sandboxed shell targeting ~/boo_box/env (install anything)
  boo tools [--json]          List installed toolchains & binaries by directory path
  boo env rm <dir-path>       Remove a toolchain directory inside ~/boo_box/env
  boo env path                Print the global sandbox env root path
  boo env reset               Wipe and recreate ~/boo_box/env cleanly

Integrations:
  boo setup-github            One-time Keychain Git + GitHub setup (--token, --from-gh, --status, --remove)
  boo -h, --help              Show this help
EOF
}

resolve_app() {
    local script_dir
    script_dir="$(cd "$(dirname "$0")" && pwd -P)"
    local candidates=()
    if [ -n "${BOOBOX_APP_PATH:-}" ]; then
        candidates+=("$BOOBOX_APP_PATH")
    fi
    if [ -f "$HOME/boo_box/.app-path" ]; then
        local recorded
        recorded="$(cat "$HOME/boo_box/.app-path" 2>/dev/null || true)"
        if [ -n "$recorded" ]; then
            candidates+=("$recorded")
        fi
    fi
    candidates+=(
        "$script_dir/../build/boo_box.app"
        "/Applications/boo_box.app"
        "$HOME/Applications/boo_box.app"
    )
    for app in "${candidates[@]}"; do
        if [ -d "$app" ]; then
            echo "$app"
            return 0
        fi
    done
    local spotlight
    spotlight="$(mdfind 'kMDItemCFBundleIdentifier == "dev.boo-box.app"' 2>/dev/null | head -n 1 || true)"
    if [ -n "$spotlight" ] && [ -d "$spotlight" ]; then
        echo "$spotlight"
        return 0
    fi
    echo "boo: boo_box.app not found (build with ./scripts/bundle-app.sh or set BOOBOX_APP_PATH)" >&2
    exit 1
}
url_encode() {
    local LC_ALL=C str="$1" i c out=""
    for (( i = 0; i < ${#str}; i++ )); do
        c="${str:i:1}"
        case "$c" in
            [a-zA-Z0-9.~_-]) out+="$c" ;;
            *) printf -v c '%%%02X' "'$c"; out+="$c" ;;
        esac
    done
    printf '%s' "$out"
}

# Route global sandbox environment & setup subcommands
case "${1:-}" in
    install|run|tools|ls|list|env)
        APP_PATH="$(resolve_app)"
        ENV_BIN="$APP_PATH/Contents/Resources/bin/boobox-env"
        if [ ! -x "$ENV_BIN" ]; then
            SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd -P)"
            ENV_BIN="$SCRIPT_DIR/boobox-env"
        fi
        exec "$ENV_BIN" "$@"
        ;;
    setup-github)
        shift
        APP_PATH="$(resolve_app)"
        SETUP_BIN="$APP_PATH/Contents/Resources/bin/boobox-setup-github"
        if [ ! -x "$SETUP_BIN" ]; then
            SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd -P)"
            SETUP_BIN="$SCRIPT_DIR/boobox-setup-github"
        fi
        exec "$SETUP_BIN" "$@"
        ;;
esac
NO_ENV=0
CLONE_MODE=""   # "" = follow config.json (default overlay), "overlay", "full", or "slim"
SCRATCH=0
TARGET=""

while [ $# -gt 0 ]; do
    case "$1" in
        -h|--help)
            usage
            exit 0
            ;;
        --no-env)
            NO_ENV=1
            shift
            ;;
        --overlay)
            CLONE_MODE="overlay"
            shift
            ;;
        --clone|--full)
            CLONE_MODE="full"
            shift
            ;;
        --slim)
            CLONE_MODE="slim"
            shift
            ;;
        --scratch)
            SCRATCH=1
            shift
            ;;
        --)
            shift
            if [ $# -gt 0 ]; then
                TARGET="$1"
                shift
            fi
            ;;
        -*)
            echo "boo: unknown option: $1" >&2
            usage >&2
            exit 2
            ;;
        *)
            TARGET="$1"
            shift
            ;;
    esac
done

APP_PATH="$(resolve_app)"
CLONE_BIN="$APP_PATH/Contents/MacOS/boobox-clone"
SOCK_PATH="$HOME/boo_box/run/app.sock"

if [ "$SCRATCH" -eq 1 ]; then
    if [ -S "$SOCK_PATH" ] && "$CLONE_BIN" --ipc-send "$SOCK_PATH" '{"op":"scratch"}' 2>/dev/null; then
        exit 0
    fi
    open -a "$APP_PATH" --args --scratch
    exit 0
fi

# If invoked bare (`boo`) inside a project directory (not ~, /, /Users, or ~/boo_box), default to $PWD
if [ -z "$TARGET" ]; then
    REAL_PWD="$(pwd -P)"
    REAL_HOME="$(cd "$HOME" && pwd -P)"
    if [ "$REAL_PWD" = "/" ] || [ "$REAL_PWD" = "/Users" ] || [ "$REAL_PWD" = "$REAL_HOME" ] || [ "$REAL_PWD" = "$REAL_HOME/boo_box" ] || [[ "$REAL_PWD" == "$REAL_HOME/boo_box/"* ]]; then
        if [ -S "$SOCK_PATH" ] && "$CLONE_BIN" --ipc-send "$SOCK_PATH" '{"op":"activate"}' 2>/dev/null; then
            exit 0
        fi
        open -a "$APP_PATH"
        exit 0
    fi
    TARGET="$REAL_PWD"
fi

if [ ! -d "$TARGET" ]; then
    echo "boo: not a directory: $TARGET" >&2
    exit 1
fi
ABS_DIR="$(cd "$TARGET" && pwd -P)"
PROJ_NAME="$(basename "$ABS_DIR")"

# Determine effective workspace mode: default "overlay" (~20 ms O(1)) unless user opted into APFS clone
USE_OVERLAY=1
if [ "$CLONE_MODE" = "full" ] || [ "$CLONE_MODE" = "slim" ]; then
    USE_OVERLAY=0
elif [ "$CLONE_MODE" != "overlay" ] && [ -f "$HOME/boo_box/config.json" ]; then
    if grep -q '"workspaceMode"[[:space:]]*:[[:space:]]*"apfsClone"' "$HOME/boo_box/config.json" 2>/dev/null; then
        USE_OVERLAY=0
    fi
fi

if [ "$USE_OVERLAY" -eq 1 ]; then
    ESC_DIR="${ABS_DIR//\\/\\\\}"; ESC_DIR="${ESC_DIR//\"/\\\"}"
    ESC_NAME="${PROJ_NAME//\\/\\\\}"; ESC_NAME="${ESC_NAME//\"/\\\"}"
    NO_ENV_JSON="false"; [ "$NO_ENV" -eq 1 ] && NO_ENV_JSON="true"
    FORCE_OVERLAY_JSON="false"; [ "$CLONE_MODE" = "overlay" ] && FORCE_OVERLAY_JSON="true"
    PAYLOAD="{\"op\":\"open\",\"path\":\"$ESC_DIR\",\"name\":\"$ESC_NAME\",\"noEnv\":$NO_ENV_JSON,\"overlay\":$FORCE_OVERLAY_JSON}"
    if [ -S "$SOCK_PATH" ] && "$CLONE_BIN" --ipc-send "$SOCK_PATH" "$PAYLOAD" 2>/dev/null; then
        exit 0
    fi
    OPEN_ARGS=(--dir "$ABS_DIR" --name "$PROJ_NAME")
    [ "$NO_ENV" -eq 1 ] && OPEN_ARGS+=(--no-env)
    [ "$CLONE_MODE" = "overlay" ] && OPEN_ARGS+=(--overlay)
    open -a "$APP_PATH" --args "${OPEN_ARGS[@]}"
    exit 0
fi

# APFS Clone mode: pop from warm pool + Git/lockfile delta-sync (<1 ms Unix socket handoff)
SESS_UUID="$(/usr/bin/uuidgen)"
SHORT_ID="s-$(printf '%s' "${SESS_UUID:0:8}" | tr '[:upper:]' '[:lower:]')"
SESS_DIR="$HOME/boo_box/sessions/$SHORT_ID"
WS_DIR="$SESS_DIR/workspace"
SESS_META="$SESS_DIR/.clone-meta.json"
mkdir -p "$SESS_DIR"

PATH_HASH="$(printf '%s' "$ABS_DIR" | /usr/bin/shasum -a 256)"
PATH_HASH="${PATH_HASH:0:10}"
TMPL_KEY="${PROJ_NAME}-${PATH_HASH}"
TMPL_DIR="$HOME/boo_box/templates/$TMPL_KEY"
WARM_DIR="$HOME/boo_box/templates/.warm-$TMPL_KEY"
WARM_META="$HOME/boo_box/templates/.warm-meta-$TMPL_KEY.json"

CLONE_ARGS=(
    "$ABS_DIR" "$WS_DIR"
    --use-config "$HOME/boo_box/config.json"
    --write-meta "$SESS_META"
    --warm-pop "$WARM_DIR"
    --warm-meta "$WARM_META"
    --notify-socket "$SOCK_PATH"
    --notify-id "$SESS_UUID"
    --notify-name "$PROJ_NAME"
    --notify-template "$TMPL_DIR"
)
if [ "$NO_ENV" -eq 1 ]; then CLONE_ARGS+=(--no-env); fi
if [ "$CLONE_MODE" = "full" ]; then CLONE_ARGS+=(--full); fi
if [ "$CLONE_MODE" = "slim" ]; then CLONE_ARGS+=(--slim); fi

if [ ! -d "$WARM_DIR" ] || [ ! -f "$WARM_META" ]; then
    printf 'boo_box: cloning %s into %s (zero-copy APFS; future runs pop warm pool)...\n' "$PROJ_NAME" "$SHORT_ID"
fi

CLONE_PID=""
cleanup_cancelled_clone() {
    trap - INT TERM
    printf '\nboo_box: cancelled — cleaning up partial clone in background...\n' >&2
    if [ -n "$CLONE_PID" ]; then
        kill -TERM "$CLONE_PID" 2>/dev/null || true
    fi
    # Detach reaping so your terminal prompt returns immediately even if macOS XNU is mid-clonefile(2)
    TRASH_DST="$HOME/boo_box/.trash-cancel-${SHORT_ID}-$$"
    nohup /bin/sh -c '
        pid="$1"; src="$2"; dst="$3"
        if [ -n "$pid" ]; then
            i=0
            while kill -0 "$pid" 2>/dev/null && [ "$i" -lt 150 ]; do
                sleep 0.2
                i=$((i + 1))
            done
            kill -KILL "$pid" 2>/dev/null || true
        fi
        if [ -d "$src" ]; then
            mv "$src" "$dst" 2>/dev/null && /bin/rm -rf "$dst" 2>/dev/null || /bin/rm -rf "$src" 2>/dev/null || true
        fi
    ' _ "$CLONE_PID" "$SESS_DIR" "$TRASH_DST" >/dev/null 2>&1 </dev/null &
    exit 130
}
trap cleanup_cancelled_clone INT TERM

RC=0
"$CLONE_BIN" "${CLONE_ARGS[@]}" &
CLONE_PID=$!
wait "$CLONE_PID" || RC=$?
trap - INT TERM

if [ "$RC" -eq 0 ]; then
    exit 0
elif [ "$RC" -eq 10 ]; then
    # Cloned cleanly, app was not running yet -> cold launch boo_box.app
    if [ "$NO_ENV" -eq 1 ]; then
        open -a "$APP_PATH" --args --ready-session "$SESS_UUID" --name "$PROJ_NAME" --template "$TMPL_DIR" --no-env
    else
        open -a "$APP_PATH" --args --ready-session "$SESS_UUID" --name "$PROJ_NAME" --template "$TMPL_DIR"
    fi
    exit 0
else
    if [ -d "$SESS_DIR" ]; then
        TRASH_DST="$HOME/boo_box/.trash-fail-${SHORT_ID}-$$"
        mv "$SESS_DIR" "$TRASH_DST" 2>/dev/null && nohup /bin/rm -rf "$TRASH_DST" >/dev/null 2>&1 </dev/null &
    fi
    exit "$RC"
fi
